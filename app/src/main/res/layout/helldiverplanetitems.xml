<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <TextView
        android:id="@+id/planetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="Super Earth"
        android:textColor="@color/light_blue"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/PlanetImage"
        android:layout_width="304dp"
        android:layout_height="157dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/planetName"
        app:srcCompat="@drawable/superearth" />

    <TextView
        android:id="@+id/PlanetLiberationText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/light_blue"
        android:textSize="15sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"
        android:fontFamily="sans-serif"
        android:text="Planet Liberation Percentage: "
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PlanetImage" />

    <TextView
        android:id="@+id/Liberation_Percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:fontFamily="sans-serif"
        android:text="100%"
        android:textColor="@color/Yellow"
        android:layout_marginTop="20dp"
        android:textSize="15sp"
        app:layout_constraintStart_toEndOf="@+id/PlanetLiberationText"
        app:layout_constraintTop_toBottomOf="@+id/PlanetImage" />

    <TextView
        android:id="@+id/planetDescription"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_marginTop="8dp"
        android:layout_marginStart="30dp"
        android:text="The Home of Managed Democracy and the home of the brave Helldivers that fight for liberty!"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/PlanetLiberationText" />
</androidx.constraintlayout.widget.ConstraintLayout>